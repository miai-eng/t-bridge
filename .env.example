# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). Safe for the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only. Used later for translation and training generation.
LLM_API_KEY=
